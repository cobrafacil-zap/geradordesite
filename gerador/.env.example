# ─────────────────────────────────────────────────────────────────
# Fábrica de Sites — variáveis de ambiente (Sistema A: Gerador)
# Copie este arquivo para .env.local e preencha.
# ─────────────────────────────────────────────────────────────────

# URL pública do Gerador (Vercel ou localhost)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (banco do Gerador) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (IA estruturada — free tier) ───────────────────
# Obtenha sua chave grátis em: https://aistudio.google.com/apikey
# Free tier: 15 req/min, 1500 req/dia (modelo gemini-2.0-flash)
GEMINI_API_KEY=
# Opcional: troque o modelo (default: gemini-2.0-flash)
# Outras opções: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash