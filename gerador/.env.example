# ─────────────────────────────────────────────────────────────────
# Fábrica de Sites — variáveis de ambiente (Sistema A: Gerador)
# Copie este arquivo para .env.local e preencha.
# ─────────────────────────────────────────────────────────────────

# URL pública do Gerador (Vercel ou localhost)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (banco do Gerador) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (IA estruturada — free tier) ───────────────────
# Obtenha sua chave grátis em: https://aistudio.google.com/apikey
# Free tier: 15 req/min, 1500 req/dia (modelo gemini-2.0-flash)
GEMINI_API_KEY=
# Opcional: troque o modelo (default: gemini-2.0-flash)
# Outras opções: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ── Mercado Pago (Checkout Pro / PIX / Cartão) ───────────────────
# Credenciais em https://www.mercadopago.com.br/developers/panel
# ATENÇÃO: use prefixo TEST- pra testes (cartão fake aceita);
# produção real (APP_USR-) cobra de verdade.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# URL que o Mercado Pago chama quando o pagamento muda de status.
# Em prod: https://geradordesite-eight.vercel.app/api/webhooks/mercadopago
# Em dev local: expor com ngrok (ex: https://abc123.ngrok.io/api/webhooks/mercadopago)
MERCADOPAGO_NOTIFICATION_URL=http://localhost:3000/api/webhooks/mercadopago

# ── Checkout (preço) ─────────────────────────────────────────────
# Em centavos. CHECKOUT_ENV decide qual usar.
# Teste: 90 (R$ 0,90) — Produção: 19700 (R$ 197,00)
CHECKOUT_TEST_AMOUNT_CENTS=90
CHECKOUT_LIVE_AMOUNT_CENTS=19700
CHECKOUT_ENV=production   # 'production' usa LIVE; comente/descomente abaixo pra forçar teste
# CHECKOUT_FORCE_TEST=true   # descomente pra forçar 0,90 mesmo em produção